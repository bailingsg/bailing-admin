# Bailing Wooden Admin - 环境变量模板
# 复制为 .env 后按需修改；.env 不得提交 Git。
# Next.js 会自动加载 .env。

# 后端 API 基础地址（本地开发默认值；后端运行于 4000 端口）
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1

# 后台名称（展示用）
NEXT_PUBLIC_ADMIN_SITE_NAME=Bailing Wooden Admin

# 前台站点地址（「查看线上页面」等跳转用；后台与前台不同源，必须绝对 URL）
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ---------- RFQ 询盘管理（服务端） ----------
# 后端 API 基地址（服务端访问，优先级高于 NEXT_PUBLIC_API_BASE_URL）
# ADMIN_API_BASE_URL=http://127.0.0.1:4000/api/v1
#
# Phase 0 起后台 RFQ 接口使用登录 JWT（Cookie admin_session）+ RBAC 权限
# （rfq.read / rfq.update），本后台**不再需要** ADMIN_API_TOKEN。

# ---------- 生产环境占位符（部署时填写） ----------
# NEXT_PUBLIC_API_BASE_URL=https://api.bailingwooden.com/api/v1
# NEXT_PUBLIC_ADMIN_SITE_URL=https://admin.bailingwooden.com
# NEXT_PUBLIC_FRONTEND_URL=https://bailingwooden.com
# 注意：任何 NEXT_PUBLIC_ 变量都会暴露到浏览器，禁止放置数据库密码、
# 邮箱密码、腾讯云 COS SecretId/SecretKey 等敏感信息。
# 后台登录 Token 等敏感信息属于服务端会话范畴，不得使用 NEXT_PUBLIC_ 前缀。

# ---------- 登录会话（Phase 4.1） ----------
# HttpOnly Cookie 会话有效期（秒），需与后端 JWT_EXPIRES_IN 保持一致（默认 15 分钟）
# ADMIN_SESSION_MAX_AGE=900
